{
  "name": "animation-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project chromium --project chromium-reduced",
    "test:e2e:gpu": "playwright test --project chromium-gpu",
    "check:bundle": "node scripts/check-home-bundle.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:bundle && pnpm test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "maath": "0.10.8",
    "next": "16.4.3",
    "postprocessing": "^6.39.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "~0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@fal-ai/client": "1.10.1",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "~0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "26.x"
  }
}
